# Copy to .env for local development. .env is git-ignored; never commit real
# credentials. Every value below is a placeholder.

# External PostgreSQL 18. Production must enable provider-appropriate TLS;
# sslmode=disable is only for the disposable local Compose database.
DATABASE_URL=postgres://storage:storage@localhost:5432/storage?sslmode=disable

# Both tokens are required, must be at least 32 UTF-8 bytes, and must differ.
# Generate real ones with: openssl rand -base64 48
API_READ_WRITE_TOKEN=replace-me-read-write-token-at-least-32-bytes
API_READ_ONLY_TOKEN=replace-me-read-only-token-at-least-32-bytes

# Optional. The defaults below match the documented defaults.
# PORT=8080
# MAX_REQUEST_BYTES=134217728
# MAX_CELLS=1000000
# DB_MAX_CONNS=4
# REQUEST_TIMEOUT=5m
# DB_TIMEOUT=4m30s
# SHUTDOWN_TIMEOUT=30s
# LOG_LEVEL=info
